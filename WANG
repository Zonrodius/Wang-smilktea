<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="奶茶日记">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#3a6b3a">
<title>🧋 小宋给小王定制的奶茶日记</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
html,body{min-height:100%;font-family:-apple-system,'PingFang SC',sans-serif;color:#1a3320;}

/* 小狗原图全屏背景，固定不动，清晰可见 */
body{
  background:url('data:image/jpeg;base64,') center top / cover no-repeat fixed;
}

/* 整体加一层极浅绿色透明膜，让配色偏绿但不遮小狗 */
body::before{
  content:'';position:fixed;inset:0;z-index:0;
  background:rgba(180,230,180,0.18);
  pointer-events:none;
}

.wrap{position:relative;z-index:1;max-width:420px;margin:0 auto;padding-bottom:30px;}

/* 标题 */
.titlebar{padding:54px 16px 10px;}
.titlebar h1{font-size:16px;font-weight:700;color:#fff;text-shadow:0 1px 6px rgba(0,0,0,0.3);}
.titlebar p{font-size:11px;color:rgba(255,255,255,0.8);margin-top:2px;text-shadow:0 1px 4px rgba(0,0,0,0.25);}

/* 玻璃卡片 — 半透明白色，清晰不模糊 */
.glass{
  background:rgba(255,255,255,0.72);
  border:0.5px solid rgba(255,255,255,0.6);
  box-shadow:0 2px 12px rgba(0,0,0,0.08);
}

/* 统计 */
.stats{display:flex;gap:10px;padding:0 14px 10px;}
.sc{flex:1;border-radius:13px;padding:11px 6px;text-align:center;}
.sc-l{font-size:10px;color:#4a7a4a;margin-bottom:4px;}
.sc-v{font-size:17px;font-weight:700;color:#1a3320;line-height:1;}
.sc-v.s{font-size:12px;margin-top:3px;}

/* 卡片 */
.card{margin:0 14px 10px;border-radius:14px;padding:13px 14px;}
.card-title{font-size:10px;color:#5a8a5a;margin-bottom:10px;font-weight:600;letter-spacing:0.04em;}

/* 日历 */
.cal-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;}
.cal-m{font-size:12px;font-weight:700;color:#1a3320;}
.cal-mid{display:flex;align-items:center;gap:10px;}
.cal-leg{display:flex;gap:8px;}
.cl{display:flex;align-items:center;gap:3px;font-size:9px;color:#5a8a5a;}
.cl-dot{width:8px;height:8px;border-radius:50%;}
.cal-nav{background:none;border:none;font-size:18px;color:#7aaa7a;cursor:pointer;padding:0 4px;line-height:1;}
.cal-nav:active{opacity:0.5;}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);}
.cwd{text-align:center;font-size:9px;color:#7aaa7a;padding-bottom:6px;font-weight:500;}
.cd{display:flex;flex-direction:column;align-items:center;padding:2px 1px;cursor:pointer;}
.cd:active{opacity:0.6;}
.cd-n{font-size:15px;font-weight:600;color:#1a3320;width:30px;height:30px;display:flex;align-items:center;justify-content:center;border-radius:50%;line-height:1;}
.cd-n.now{background:#e05555;color:#fff;font-weight:700;}
.cd-n.tea{background:#4caf50;color:#fff;}
.cd-n.lo{color:#aaccaa;}

/* 表单 */
.fl{font-size:10px;color:#5a8a5a;display:block;margin-bottom:3px;font-weight:500;}
.fi{height:38px;width:100%;border:0.5px solid rgba(255,255,255,0.5);border-radius:9px;background:rgba(255,255,255,0.6);color:#1a3320;font-size:13px;padding:0 10px;font-family:inherit;appearance:none;-webkit-appearance:none;outline:none;}
.fi::placeholder{color:#9abf9a;font-size:12px;}
.fi:focus{border-color:rgba(100,180,100,0.6);background:rgba(255,255,255,0.85);}
.fi option{background:#fff;color:#1a3320;}
.row{display:flex;gap:9px;margin-bottom:8px;}
.fg{flex:1;display:flex;flex-direction:column;}
.ph-box{width:38px;height:38px;border-radius:9px;flex-shrink:0;border:1px dashed rgba(255,255,255,0.5);background:rgba(255,255,255,0.5);display:flex;align-items:center;justify-content:center;cursor:pointer;overflow:hidden;}
.ph-box img{width:100%;height:100%;object-fit:cover;}
.btn{margin-top:4px;width:100%;height:42px;background:rgba(60,140,60,0.85);color:#fff;border:0.5px solid rgba(100,180,100,0.4);border-radius:10px;font-size:14px;font-weight:700;font-family:inherit;cursor:pointer;letter-spacing:0.05em;transition:opacity 0.12s,transform 0.1s;}
.btn:active{opacity:0.82;transform:scale(0.98);}

/* 月份列表 */
.list{padding:0 14px;display:flex;flex-direction:column;gap:8px;padding-bottom:20px;}
.mp{border-radius:14px;overflow:hidden;}
.mp-hd{display:flex;align-items:center;justify-content:space-between;padding:11px 14px;cursor:pointer;user-select:none;-webkit-user-select:none;}
.mp-l{display:flex;align-items:center;gap:7px;}
.mp-ic{font-size:14px;}
.mp-name{font-size:13px;font-weight:700;color:#1a3320;}
.mp-ct{font-size:10px;color:#5a8a5a;margin-left:2px;}
.mp-r{display:flex;align-items:center;gap:5px;}
.mp-amt{font-size:13px;font-weight:700;color:#2e7d32;}
.mp-arr{font-size:9px;color:#7aaa7a;transition:transform 0.26s;display:inline-block;}
.mp-arr.o{transform:rotate(90deg);}
.mp-body{max-height:0;overflow:hidden;transition:max-height 0.35s cubic-bezier(0.4,0,0.2,1);border-top:0.5px solid rgba(255,255,255,0.3);}
.mp-body.o{max-height:4000px;}
.dg{padding:8px 14px 4px;}
.dl{font-size:10px;color:#7aaa7a;margin-bottom:5px;}
.it{display:flex;align-items:center;gap:9px;background:rgba(255,255,255,0.5);border-radius:10px;padding:8px 10px;margin-bottom:6px;}
.it-th{width:38px;height:38px;border-radius:8px;overflow:hidden;flex-shrink:0;background:rgba(200,235,200,0.6);display:flex;align-items:center;justify-content:center;cursor:pointer;}
.it-th img{width:100%;height:100%;object-fit:cover;}
.it-em{font-size:19px;line-height:1;}
.it-b{flex:1;min-width:0;}
.it-n{font-size:13px;font-weight:500;color:#1a3320;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.it-m{display:flex;gap:4px;margin-top:2px;flex-wrap:wrap;}
.tg{font-size:10px;color:#5a8a5a;}
.it-r{display:flex;align-items:center;gap:6px;flex-shrink:0;}
.it-p{font-size:13px;font-weight:700;color:#2e7d32;min-width:44px;text-align:right;}
.db{background:none;border:none;cursor:pointer;color:rgba(150,190,150,0.6);font-size:14px;width:22px;height:22px;display:flex;align-items:center;justify-content:center;}
.db:active{color:#5a8a5a;}
.empty{text-align:center;padding:40px;color:rgba(255,255,255,0.8);font-size:13px;line-height:2.2;text-shadow:0 1px 4px rgba(0,0,0,0.2);}
.lbx{position:fixed;inset:0;background:rgba(0,0,0,0.88);display:flex;align-items:center;justify-content:center;z-index:999;cursor:pointer;}
.lbx img{max-width:92%;max-height:88vh;border-radius:14px;}

@supports(padding-top:env(safe-area-inset-top)){
  .titlebar{padding-top:calc(54px + env(safe-area-inset-top));}
}
@supports(padding-bottom:env(safe-area-inset-bottom)){
  .wrap{padding-bottom:calc(30px + env(safe-area-inset-bottom));}
}
</style>
</head>
<body>
<div class="wrap">
  <div class="titlebar">
    <h1>🧋 小宋给小王定制的奶茶日记</h1>
    <p id="ds"></p>
  </div>

  <div class="stats">
    <div class="sc glass"><div class="sc-l">累计花费</div><div class="sc-v" id="st">¥0</div></div>
    <div class="sc glass"><div class="sc-l">喝了多少杯</div><div class="sc-v" id="sc2">0 杯</div></div>
    <div class="sc glass"><div class="sc-l">最爱品牌</div><div class="sc-v s" id="sy">—</div></div>
  </div>

  <div class="card glass">
    <div class="cal-hd">
      <button class="cal-nav" onclick="cm(-1)">‹</button>
      <div class="cal-mid">
        <span class="cal-m" id="ct"></span>
        <div class="cal-leg">
          <div class="cl"><div class="cl-dot" style="background:#e05555"></div>今天</div>
          <div class="cl"><div class="cl-dot" style="background:#4caf50"></div>喝了</div>
        </div>
      </div>
      <button class="cal-nav" onclick="cm(1)">›</button>
    </div>
    <div class="cal-grid" id="cg"></div>
  </div>

  <div class="card glass">
    <div class="card-title">记录新的一杯</div>
    <div class="row"><div class="fg"><label class="fl">奶茶名称</label><input class="fi" id="in" placeholder="珍珠奶茶、芋泥波波…" autocomplete="off"/></div></div>
    <div class="row">
      <div class="fg"><label class="fl">品牌 / 店家</label><input class="fi" id="ib" placeholder="喜茶、一点点…" autocomplete="off"/></div>
      <div class="fg"><label class="fl">金额（元）</label><input class="fi" id="ip" type="number" placeholder="0.00" min="0" step="0.5" inputmode="decimal"/></div>
    </div>
    <div class="row">
      <div class="fg"><label class="fl">甜度</label>
        <select class="fi" id="is"><option value="">不选</option><option>无糖</option><option>少糖</option><option>半糖</option><option>七分糖</option><option>全糖</option></select>
      </div>
      <div class="fg"><label class="fl">城市</label><input class="fi" id="ic" placeholder="上海…" autocomplete="off"/></div>
    </div>
    <div class="row" style="margin-bottom:4px;align-items:flex-end;">
      <div class="fg"><label class="fl">日期</label><input class="fi" id="id" type="date"/></div>
      <div style="display:flex;flex-direction:column;align-items:center;gap:3px;flex-shrink:0;">
        <span class="fl" style="text-align:center;">照片</span>
        <div class="ph-box" onclick="document.getElementById('ph').click()">
          <span id="phi" style="font-size:17px;">📷</span>
          <img id="pht" style="display:none;width:100%;height:100%;object-fit:cover;"/>
        </div>
        <input type="file" id="ph" style="display:none" accept="image/*" capture="environment" onchange="pv(this)"/>
      </div>
    </div>
    <button class="btn" onclick="add()">＋ 记录这一杯</button>
  </div>

  <div class="list" id="list"></div>
</div>

<script>
const K="milktea_v3";
let PP=null,CY,CM;
const N=new Date();CY=N.getFullYear();CM=N.getMonth();
const DN=["日","一","二","三","四","五","六"];
const MI=["❄️","🌱","🌸","🌿","☀️","🍵","🧋","🍂","🌾","🍁","🌨️","🎄"];
function ld(){try{return JSON.parse(localStorage.getItem(K)||"[]");}catch(e){return[];}}
function sv(r){localStorage.setItem(K,JSON.stringify(r));}
function td(){return new Date().toISOString().slice(0,10);}
const nd=new Date();
document.getElementById("ds").textContent=nd.getFullYear()+"年"+(nd.getMonth()+1)+"月"+nd.getDate()+"日 周"+DN[nd.getDay()];
function pv(i){
  const f=i.files[0];if(!f)return;
  const r=new FileReader();
  r.onload=e=>{PP=e.target.result;const t=document.getElementById("pht");t.src=PP;t.style.display="block";document.getElementById("phi").style.display="none";};
  r.readAsDataURL(f);
}
const EM=["🧋","🍵","🥤","☕","🍶","🫖"];
function pe(n){
  if(!n)return"🧋";if(/抹茶|绿茶|茉莉/.test(n))return"🍵";if(/咖啡|拿铁/i.test(n))return"☕";if(/水果|草莓|芒果|柠檬/.test(n))return"🥤";
  let h=0;for(let c of n)h=(h*31+c.charCodeAt(0))&0xff;return EM[h%EM.length];
}
function add(){
  const n=document.getElementById("in").value.trim();if(!n){document.getElementById("in").focus();return;}
  const p=parseFloat(document.getElementById("ip").value)||0;
  const b=document.getElementById("ib").value.trim();const s=document.getElementById("is").value;
  const c=document.getElementById("ic").value.trim();const d=document.getElementById("id").value||td();
  const rs=ld();rs.unshift({id:Date.now(),name:n,brand:b,price:p,sugar:s,city:c,date:d,emoji:pe(n),photo:PP});sv(rs);
  ["in","ib","ip","ic"].forEach(x=>document.getElementById(x).value="");
  document.getElementById("is").value="";document.getElementById("id").value=td();
  document.getElementById("ph").value="";document.getElementById("pht").style.display="none";document.getElementById("phi").style.display="inline";
  PP=null;ra();
}
function del(id){if(!confirm("确定删除？"))return;sv(ld().filter(r=>r.id!==id));ra();}
function sp(src){const l=document.createElement("div");l.className="lbx";l.innerHTML=`<img src="${src}"/>`;l.onclick=()=>l.remove();document.body.appendChild(l);}
function cm(d){CM+=d;if(CM>11){CM=0;CY++;}if(CM<0){CM=11;CY--;}rc(ld());}
function rc(rs){
  const ms=["一","二","三","四","五","六","七","八","九","十","十一","十二"];
  document.getElementById("ct").textContent=CY+"年"+ms[CM]+"月";
  const tea={};rs.forEach(r=>{tea[r.date]=(tea[r.date]||0)+1;});
  const fd=new Date(CY,CM,1).getDay();const dim=new Date(CY,CM+1,0).getDate();
  const ts=td();const now=new Date();now.setHours(0,0,0,0);
  let h=`<div class="cwd">日</div><div class="cwd">一</div><div class="cwd">二</div><div class="cwd">三</div><div class="cwd">四</div><div class="cwd">五</div><div class="cwd">六</div>`;
  for(let i=0;i<fd;i++)h+=`<div></div>`;
  for(let day=1;day<=dim;day++){
    const ds=CY+"-"+String(CM+1).padStart(2,"0")+"-"+String(day).padStart(2,"0");
    const fut=new Date(CY,CM,day)>now;const isT=ds===ts;const cnt=tea[ds]||0;
    let cls="cd-n";
    if(isT)cls+=" now";else if(fut)cls+=" lo";else if(cnt>0)cls+=" tea";
    h+=`<div class="cd" onclick="ci('${ds}')"><div class="${cls}">${day}</div></div>`;
  }
  document.getElementById("cg").innerHTML=h;
}
function ci(ds){document.getElementById("id").value=ds;document.querySelector(".card").scrollIntoView({behavior:"smooth"});}
const OM=new Set();
function fm(ym){const[y,m]=ym.split("-");return y+"年"+parseInt(m)+"月";}
function fd2(day){
  const dt=new Date(day+"T00:00:00");const s=day===td()?" 今天":" 周"+DN[dt.getDay()];
  const[,mm,dd]=day.split("-");return parseInt(mm)+"月"+parseInt(dd)+"日"+s;
}
function rs2(rs){
  const tot=rs.reduce((s,r)=>s+(r.price||0),0);
  document.getElementById("st").textContent="¥"+tot.toFixed(2);
  document.getElementById("sc2").textContent=rs.length+" 杯";
  const bm={};rs.forEach(r=>{if(r.brand)bm[r.brand]=(bm[r.brand]||0)+1;});
  let fav="—",mx=0;for(const[b,c]of Object.entries(bm)){if(c>mx){mx=c;fav=b;}}
  document.getElementById("sy").textContent=fav;
}
function rl(rs){
  const root=document.getElementById("list");
  if(!rs.length){root.innerHTML='<div class="empty">🧋<br>还没有记录<br>快去买一杯吧！</div>';return;}
  const mm={};
  rs.forEach(r=>{const ym=r.date.slice(0,7);if(!mm[ym])mm[ym]={total:0,cups:0,days:{}};mm[ym].total+=(r.price||0);mm[ym].cups++;if(!mm[ym].days[r.date])mm[ym].days[r.date]=[];mm[ym].days[r.date].push(r);});
  const mths=Object.keys(mm).sort((a,b)=>b.localeCompare(a));
  if(!OM.size&&mths.length)OM.add(mths[0]);
  let h="";
  mths.forEach(ym=>{
    const m=mm[ym];const op=OM.has(ym);const[,mo]=ym.split("-");
    const days=Object.keys(m.days).sort((a,b)=>b.localeCompare(a));
    h+=`<div class="mp glass"><div class="mp-hd" onclick="tm('${ym}')"><div class="mp-l"><span class="mp-arr${op?" o":""}">▶</span><span class="mp-ic" style="margin-left:6px;">${MI[parseInt(mo)-1]}</span><span class="mp-name">${fm(ym)}</span><span class="mp-ct">${m.cups} 杯</span></div><div class="mp-r"><span class="mp-amt">¥${m.total.toFixed(2)}</span></div></div><div class="mp-body${op?" o":""}">`;
    days.forEach(day=>{
      h+=`<div class="dg"><div class="dl">${fd2(day)}</div>`;
      m.days[day].forEach(r=>{
        const th=r.photo?`<div class="it-th" onclick="sp('${r.photo}')"><img src="${r.photo}"/></div>`:`<div class="it-th"><span class="it-em">${r.emoji||"🧋"}</span></div>`;
        h+=`<div class="it">${th}<div class="it-b"><div class="it-n">${r.name}</div><div class="it-m">${r.brand?`<span class="tg">${r.brand}</span>`:""} ${r.sugar?`<span class="tg">${r.sugar}</span>`:""} ${r.city?`<span class="tg">📍${r.city}</span>`:""}</div></div><div class="it-r"><span class="it-p">${r.price?"¥"+r.price.toFixed(2):"—"}</span><button class="db" onclick="del(${r.id})">×</button></div></div>`;
      });
      h+=`</div>`;
    });
    h+=`</div></div>`;
  });
  root.innerHTML=h;
}
function tm(ym){if(OM.has(ym))OM.delete(ym);else OM.add(ym);rl(ld());}
function ra(){const rs=ld();rs2(rs);rc(rs);rl(rs);}
document.getElementById("id").value=td();ra();
</script>
</body>
</html>
